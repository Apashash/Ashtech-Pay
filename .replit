modules = ["nodejs-20", "web", "bash", "python-3.12"]
[nix]
channel = "stable-25_05"
packages = ["freetype", "gumbo", "harfbuzz", "jbig2dec", "libjpeg_turbo", "mupdf", "openjpeg", "swig", "unzip", "xcbuild", "mariadb"]

[agent]
expertMode = true
stack = "FULLSTACK_JS"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Local MySQL"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/start-local-mysql-dev.sh"
waitForPort = 5000

[[workflows.workflow]]
name = "Local MySQL"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "LOCAL_MYSQL_ONLY=true bash scripts/start-local-mysql-dev.sh"

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
run = ["node", "./dist/index.cjs"]
deploymentTarget = "autoscale"
build = ["npm", "run", "build"]

[userenv]

[userenv.shared]
PORT = "5000"
NODE_ENV = "development"
TRUST_PROXY = "true"
APP_URL = "https://www.ashtechpay.com"

[userenv.development]
DB_DIALECT = "mysql"
DEBUG_DATABASE_ERRORS = "true"

[userenv.production]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000
