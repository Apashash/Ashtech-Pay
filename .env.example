# ─── BASE DE DONNÉES ─────────────────────────────────────────────────────────
# URL Supabase PostgreSQL (connection pooling recommandé)
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
SUPABASE_DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# ─── SUPABASE STORAGE (fichiers KYC, images) ─────────────────────────────────
SUPABASE_URL=https://[ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_ANON_KEY=eyJ...

# ─── SESSION ──────────────────────────────────────────────────────────────────
# Minimum 32 caractères aléatoires — générer avec : openssl rand -hex 32
SESSION_SECRET=changez-moi-par-une-chaine-aleatoire-longue-et-securisee

# ─── APPLICATION ──────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
# URL publique sans slash final — utilisée pour CORS et webhooks
APP_URL=https://votre-domaine.com

# ─── COOKIES / PROXY ─────────────────────────────────────────────────────────
# true si l'app est derrière un reverse proxy HTTPS (Plesk/nginx/Apache)
TRUST_PROXY=true
COOKIE_SECURE=true
COOKIE_SAMESITE=none

# ─── SWYCHR / ACCOUNTPE ──────────────────────────────────────────────────────
SWYCHR_EMAIL=votre@email.com
SWYCHR_PASSWORD=votre-mot-de-passe-swychr

# ─── AFRIBAPAY ────────────────────────────────────────────────────────────────
AFRIBAPAY_PUBLIC_KEY=pk_...
AFRIBAPAY_SECRET_KEY=sk_...
AFRIBAPAY_MERCHANT_KEY=mk_...
AFRIBAPAY_AGENT_ID=agent_...

# ─── PIXPAY ───────────────────────────────────────────────────────────────────
PIXPAY_API_KEY_XAF=votre-cle-xaf
PIXPAY_API_KEY_XOF=votre-cle-xof
PIXPAY_API_KEY_CDF=votre-cle-cdf
PIXPAY_WAVE_BUSINESS_ID=votre-id-wave

# ─── EMAIL (RESEND) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
