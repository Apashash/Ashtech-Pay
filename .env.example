# =============================================================================
# .env.example — Variables d'environnement Ashtech Pay
#
# COMMENT UTILISER :
#   1. Copiez ce fichier en .env  :  cp .env.example .env
#   2. Remplissez les valeurs réelles dans .env
#   3. OU configurez ces variables directement dans Plesk :
#      Domaines > votre-domaine > Node.js > Variables d'environnement
#
# ⚠️  Ne commitez JAMAIS le fichier .env sur GitHub (.env est dans .gitignore)
# =============================================================================

# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
APP_URL=https://ashtechpay.top

# ─── Proxy / Cookies (Plesk = reverse proxy HTTPS) ───────────────────────────
TRUST_PROXY=true
COOKIE_SECURE=true
COOKIE_SAMESITE=none

# ─── Base de données (Supabase PostgreSQL) ────────────────────────────────────
# Trouvez l'URL dans : Supabase > Project Settings > Database > Connection string
# Utilisez le mode "Transaction" (port 6543) pour la stabilité
SUPABASE_DATABASE_URL=postgresql://postgres.XXXX:MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:6543/postgres

# ─── Supabase Storage (KYC, images) ──────────────────────────────────────────
# Supabase > Project Settings > API
SUPABASE_URL=https://XXXX.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Sécurité sessions ────────────────────────────────────────────────────────
# Générer avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=CHANGEZ_MOI_chaine_aleatoire_longue_64_caracteres_minimum

# ─── Chemin secret du panneau admin ───────────────────────────────────────────
# Le chemin admin secret est codé en dur dans client/src/lib/adminPath.ts
# (ce n'est plus une variable d'environnement). Modifiez cette constante pour
# le changer — pas de variable à définir ici.

# ─── Swychr / AccountPE (passerelle principale) ───────────────────────────────
SWYCHR_EMAIL=votre@email.com
SWYCHR_PASSWORD=votre_mot_de_passe_swychr

# ─── AfribaPay ────────────────────────────────────────────────────────────────
AFRIBAPAY_PUBLIC_KEY=pk_...
AFRIBAPAY_SECRET_KEY=sk_...
AFRIBAPAY_MERCHANT_KEY=mk_...
AFRIBAPAY_AGENT_ID=agent_...

# ─── PixPay ───────────────────────────────────────────────────────────────────
PIXPAY_API_KEY_XAF=PIX_votre_cle_xaf
PIXPAY_API_KEY_XOF=PIX_votre_cle_xof
PIXPAY_API_KEY_CDF=PIX_votre_cle_cdf
PIXPAY_WAVE_BUSINESS_ID=am-votre_business_id

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
