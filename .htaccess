# =============================================================================
# .htaccess — Ashtech Pay — Blocage des fichiers source sensibles
#
# Passenger (Plesk Node.js) gère le routage vers l'application.
# Ce fichier bloque uniquement l'accès direct aux fichiers source.
#
# NOTE: Toujours utiliser [F,L] (403 Forbidden) pour bloquer — JAMAIS [R=404,L].
# [R=404,L] avec substitution "-" envoie un Location header vers la même URL,
# créant une boucle vide que Safari iOS interprète comme un téléchargement (Zero KB).
# =============================================================================

Options -Indexes
RewriteEngine On

# ── Bloquer les scanners de bots / WordPress / exploits connus ───────────────
RewriteRule ^wp-admin(/.*)?$ - [F,L]
RewriteRule ^wp-login\.php$ - [F,L]
RewriteRule ^wp-config\.php$ - [F,L]
RewriteRule ^xmlrpc\.php$ - [F,L]
RewriteRule ^phpmyadmin(/.*)?$ - [F,L]
RewriteRule ^pma(/.*)?$ - [F,L]
RewriteRule ^admin\.php$ - [F,L]
RewriteRule ^administrator(/.*)?$ - [F,L]
RewriteRule ^shell\.php$ - [F,L]
RewriteRule ^c99\.php$ - [F,L]
RewriteRule ^r57\.php$ - [F,L]
RewriteRule ^cmd\.php$ - [F,L]
RewriteRule ^eval\.php$ - [F,L]
RewriteRule ^webshell\.php$ - [F,L]
RewriteRule ^setup\.php$ - [F,L]
RewriteRule ^install\.php$ - [F,L]
RewriteRule ^config\.php$ - [F,L]
RewriteRule ^database\.php$ - [F,L]
RewriteRule ^backup\.(zip|sql|tar\.gz)$ - [F,L]
RewriteRule ^dump\.sql$ - [F,L]
RewriteRule ^db\.sql$ - [F,L]
RewriteRule ^cgi-bin(/.*)?$ - [F,L]
RewriteRule ^vendor/phpunit(/.*)?$ - [F,L]
RewriteRule ^telescope(/.*)?$ - [F,L]
RewriteRule ^horizon(/.*)?$ - [F,L]
RewriteRule ^actuator(/.*)?$ - [F,L]
RewriteRule ^\.htpasswd$ - [F,L]

# ── Bloquer les dossiers source serveur ──────────────────────────────────────
RewriteRule ^server/ - [F,L]
RewriteRule ^shared/ - [F,L]
RewriteRule ^node_modules/ - [F,L]
RewriteRule ^migrations/ - [F,L]
RewriteRule ^script/ - [F,L]
RewriteRule ^attached_assets/ - [F,L]
RewriteRule ^\.git/ - [F,L]
RewriteRule ^\.git$ - [F,L]

# ── Bloquer les fichiers sensibles à la racine ───────────────────────────────
RewriteRule ^package\.json$ - [F,L]
RewriteRule ^package-lock\.json$ - [F,L]
RewriteRule ^tsconfig\.json$ - [F,L]
RewriteRule ^drizzle\.config\.ts$ - [F,L]
RewriteRule ^vite\.config\.ts$ - [F,L]
RewriteRule ^\.env$ - [F,L]
RewriteRule ^\.env\..+$ - [F,L]

# ── Bloquer par extension de fichier (source brut) ───────────────────────────
RewriteRule \.ts$ - [F,L]
RewriteRule \.tsx$ - [F,L]
RewriteRule \.map$ - [F,L]
RewriteRule \.cjs\.map$ - [F,L]

# ── Bloquer tous les fichiers cachés (commençant par un point) ───────────────
# Inclut .gitignore, .htaccess, .env, .git, etc.
RewriteRule (^|/)\. - [F,L]

# ── Pass-through vers Passenger / Node.js ────────────────────────────────────
# Sert les fichiers statiques existants directement (assets, images, etc.)
# Toutes les autres requêtes sont transmises à l'application Node.js.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ - [QSA,L]
