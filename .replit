modules = ["nodejs-20", "web", "bash", "python-base-3.13", "postgresql-16"]
[nix]
channel = "stable-25_05"
packages = ["freetype", "gumbo", "harfbuzz", "jbig2dec", "libjpeg_turbo", "mupdf", "openjpeg", "swig", "unzip", "xcbuild"]

[agent]
expertMode = true
stack = "FULLSTACK_JS"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5097
externalPort = 5000

[[ports]]
localPort = 5098
externalPort = 4200

[[ports]]
localPort = 5099
externalPort = 3003

[[ports]]
localPort = 5511
externalPort = 3001

[[ports]]
localPort = 5513
externalPort = 3000

[deployment]
run = ["node", "./dist/index.cjs"]
deploymentTarget = "autoscale"
build = ["npm", "run", "build"]

[userenv]

[userenv.shared]
PORT = "5000"
NODE_ENV = "development"
TRUST_PROXY = "true"
APP_URL = "https://www.ashtechpay.com"

[userenv.development]
DB_DIALECT = "mysql"
DEBUG_DATABASE_ERRORS = "true"

[userenv.production]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000
