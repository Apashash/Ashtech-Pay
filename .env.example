# Ashtech Pay - Variables d'environnement requises
# Copiez ce fichier vers .env et remplissez les valeurs

# ===========================================
# SUPABASE (Base de données et stockage)
# ===========================================
# Trouvez ces valeurs dans: Supabase Dashboard > Settings > API

# URL du projet Supabase (commence par https://)
SUPABASE_URL=https://votre-projet.supabase.co

# Clé publique anon (pour le client)
SUPABASE_ANON_KEY=eyJhbGciOi...votre-cle-anon

# URL de connexion à la base de données PostgreSQL
SUPABASE_DATABASE_URL=postgresql://postgres:mot-de-passe@db.votre-projet.supabase.co:5432/postgres

# ===========================================
# SESSION (Sécurité)
# ===========================================
# Clé secrète pour signer les sessions (générez une chaîne aléatoire)
SESSION_SECRET=votre-cle-secrete-aleatoire-32-caracteres

# ===========================================
# BASE DE DONNÉES LOCALE (Replit - auto-généré)
# ===========================================
# Ces variables sont automatiquement définies par Replit
# DATABASE_URL=postgresql://...
# PGHOST=...
# PGPORT=...
# PGUSER=...
# PGPASSWORD=...
# PGDATABASE=...
