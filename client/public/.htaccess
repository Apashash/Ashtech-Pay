Options -Indexes -MultiViews
RewriteEngine On
RewriteBase /

# Servir les fichiers et dossiers existants directement (assets, images, etc.)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Ne pas réécrire les routes API (laisser passer vers Node.js/Passenger)
RewriteRule ^api/ - [L]

# Toutes les autres routes → index.html (SPA routing)
RewriteRule ^ index.html [QSA,L]
