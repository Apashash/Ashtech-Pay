# =============================================================================
# .env.example — Variables d'environnement Ashtech Pay
#
# COMMENT UTILISER :
#   1. Copiez ce fichier en .env  :  cp .env.example .env
#   2. Remplissez les valeurs réelles dans .env
#   3. OU configurez ces variables directement dans Plesk :
#      Domaines > votre-domaine > Node.js > Variables d'environnement
#
# ⚠️  Ne commitez JAMAIS le fichier .env sur GitHub (.env est dans .gitignore)
# =============================================================================

# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
APP_URL=

# ─── Proxy / Cookies (Plesk = reverse proxy HTTPS) ───────────────────────────
TRUST_PROXY=true
COOKIE_SECURE=true
COOKIE_SAMESITE=none

# ─── Base de données (Supabase PostgreSQL) ────────────────────────────────────
# Trouvez l'URL dans : Supabase > Project Settings > Database > Connection string
# Utilisez le mode "Transaction" (port 6543) pour la stabilité
SUPABASE_DATABASE_URL=

# ─── Migration finale vers MySQL/MariaDB (opt-in, après validation complète) ─
# Laisser vide en mode PostgreSQL. Ne pas définir DB_DIALECT=mysql avant
# l'import du dump, la comparaison des compteurs et les tests de basculement.
DB_DIALECT=postgres
MYSQL_DATABASE_URL=

# ─── Supabase Storage (KYC, images de paiement) ──────────────────────────────
# Supabase > Project Settings > API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=uploads

# ─── Stockage des images de paiement ─────────────────────────────────────────
# Les images de paiement sont persistées dans Supabase Storage.
PAYMENT_IMAGE_STORAGE=supabase

# ─── Sécurité sessions ────────────────────────────────────────────────────────
# Générer avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=

# ─── Chemin secret du panneau admin ───────────────────────────────────────────
# Le chemin admin secret est codé en dur dans client/src/lib/adminPath.ts
# (ce n'est plus une variable d'environnement). Modifiez cette constante pour
# le changer — pas de variable à définir ici.


# ─── AfribaPay ────────────────────────────────────────────────────────────────
AFRIBAPAY_PUBLIC_KEY=
AFRIBAPAY_SECRET_KEY=
AFRIBAPAY_MERCHANT_KEY=
AFRIBAPAY_AGENT_ID=

# ─── PixPay ───────────────────────────────────────────────────────────────────
PIXPAY_API_KEY_XAF=
PIXPAY_API_KEY_XOF=
PIXPAY_API_KEY_CDF=
PIXPAY_WAVE_BUSINESS_ID=

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
